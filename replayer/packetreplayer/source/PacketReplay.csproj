<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PacketReplay</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../recognizer/core/memoline/Memoline.Core.csproj" />
    <Compile Include="../../strokereplayer/source/*.cs" Exclude="../../strokereplayer/source/Program.cs;../../strokereplayer/source/ReplayWindow.cs;../../strokereplayer/source/AssemblyInfo.cs;../../strokereplayer/source/CspPlacement.cs;../../strokereplayer/source/DriverProfile.cs;../../strokereplayer/source/StrokeBinaryReader.cs;../../strokereplayer/source/StrokeJsonReader.cs;../../strokereplayer/source/StrokeModels.cs" Link="StrokeReplay/%(Filename)%(Extension)" />
    <Compile Include="../../../Memoline_demo_csponly/source/BundleArchive.cs" Link="Memoline/BundleArchive.cs" />
  </ItemGroup>
</Project>
