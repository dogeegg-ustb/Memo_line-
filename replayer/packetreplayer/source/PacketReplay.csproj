    <Compile Include="../../../Memoline_demo_csponly/source/BundleArchive.cs" Link="Memoline/BundleArchive.cs" />
    <Compile Include="../../../Memoline_demo_csponly/source/BundleArchive.Project.cs" Link="Memoline/BundleArchive.Project.cs" />
    <Compile Include="../../../Memoline_demo_csponly/source/BundleArchive.EditSources.cs" Link="Memoline/BundleArchive.EditSources.cs" />
    <Compile Include="../../../Memoline_demo_csponly/source/Editing/EditJournal.cs" Link="Memoline/Editing/EditJournal.cs" />
