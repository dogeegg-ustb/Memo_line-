    <Compile Include="../../../Memoline_demo_csponly/source/Editing/NativeUndoTimeline.cs" Link="Memoline/Editing/NativeUndoTimeline.cs" />
    <Compile Include="../../../Memoline_demo_csponly/source/Editing/NativeUndoUnits.cs" Link="Memoline/Editing/NativeUndoUnits.cs" />
    <Compile Include="../../../Organizer/dirty matrix/source/Core/Coverage.cs" Link="DirtyMatrix/Coverage.cs" />
    <EmbeddedResource Include="../../../Memoline_demo_csponly/source/Editing/Resources/*.json" Link="Editing/Resources/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
