<Window x:Class="WorkspaceBorderDetect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作区边框识别"
        Height="280"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="工作区边框识别"
               FontSize="20"
               FontWeight="SemiBold"
               Margin="0,0,0,12"/>

    <TextBlock x:Name="StatusText"
               Grid.Row="1"
               TextWrapping="Wrap"
               VerticalAlignment="Top"
               Text="就绪。点击「开始识别工作区」冻结桌面并框选 ROI。"/>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button x:Name="StartButton"
              Content="开始识别工作区"
              MinWidth="140"
              Padding="12,8"
              Margin="0,0,8,0"
              Click="StartButton_OnClick"/>
      <Button x:Name="RedetectButton"
              Content="重新检测"
              MinWidth="100"
              Padding="12,8"
              Margin="0,0,8,0"
              Click="RedetectButton_OnClick"/>
      <Button x:Name="HideOverlayButton"
              Content="隐藏覆盖层"
              MinWidth="100"
              Padding="12,8"
              Click="HideOverlayButton_OnClick"/>
    </StackPanel>
  </Grid>
</Window>
