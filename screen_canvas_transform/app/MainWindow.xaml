<Window x:Class="ScreenCanvasTransform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen ↔ Canvas Transform"
        Height="360"
        Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="屏幕—画布坐标转换"
               FontSize="20"
               FontWeight="SemiBold"
               Margin="0,0,0,12"/>

    <TextBlock x:Name="StatusText"
               Grid.Row="1"
               TextWrapping="Wrap"
               VerticalAlignment="Top"
               Text="就绪。点击开始：隐藏覆盖层 → 冻结截图 → 框选工作区 → 纠正 → 框选导航器 → C-II/观测/OCR/求解 → 橙色 L 标记。"/>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button x:Name="StartButton"
              Content="开始初始化"
              MinWidth="140"
              Padding="12,8"
              Margin="0,0,8,0"
              Click="StartButton_OnClick"/>
      <Button x:Name="HideOverlayButton"
              Content="隐藏标记"
              MinWidth="100"
              Padding="12,8"
              Click="HideOverlayButton_OnClick"/>
    </StackPanel>
  </Grid>
</Window>
