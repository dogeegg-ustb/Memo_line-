<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MemolineDemo</AssemblyName>
    <AssemblyTitle>Memoline</AssemblyTitle>
    <Product>Memoline</Product>
    <Description>CSP 记录器与聚集事件组织器</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../recognizer/core/memoline/Memoline.Core.csproj" />
    <Compile Include="../../Organizer/canvas layer watcher/source/*.cs" Exclude="../../Organizer/canvas layer watcher/source/Program.cs" Link="Watcher/%(Filename)%(Extension)" />
    <Compile Include="../../Organizer/dirty matrix/source/Core/Coverage.cs" Link="DirtyMatrix/Coverage.cs" />
    <Compile Include="../../replayer/packetreplayer/source/*.cs"
             Exclude="../../replayer/packetreplayer/source/Program.cs;../../replayer/packetreplayer/source/PacketReplayWindow.cs;../../replayer/packetreplayer/source/AssemblyInfo.cs"
             Link="PacketReplay/%(Filename)%(Extension)" />
    <Compile Include="../../replayer/strokereplayer/source/*.cs"
             Exclude="../../replayer/strokereplayer/source/Program.cs;../../replayer/strokereplayer/source/ReplayWindow.cs;../../replayer/strokereplayer/source/AssemblyInfo.cs;../../replayer/strokereplayer/source/CspPlacement.cs;../../replayer/strokereplayer/source/DriverProfile.cs;../../replayer/strokereplayer/source/StrokeBinaryReader.cs;../../replayer/strokereplayer/source/StrokeJsonReader.cs;../../replayer/strokereplayer/source/StrokeModels.cs"
             Link="StrokeReplay/%(Filename)%(Extension)" />
    <Compile Include="../../replayer/dirty matrix paster/source/ClipboardImageCodec.cs" Link="DirtyMatrix/ClipboardImageCodec.cs" />
    <InternalsVisibleTo Include="MemolineDemo.Checks" />
    <EmbeddedResource Include="Editing/Resources/*.json" />
  </ItemGroup>
</Project>
